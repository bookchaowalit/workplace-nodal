{
  "name": "organization-environment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "office:dev": "tsx scripts/office-dev.ts",
    "office:https": "tsx scripts/office-dev.ts --https",
    "office:lan": "tsx scripts/office-dev.ts --lan",
    "office:lan:https": "tsx scripts/office-dev.ts --lan --https",
    "office:media": "tsx scripts/office-dev.ts --media",
    "office:media:https": "tsx scripts/office-dev.ts --media --https",
    "office:media:lan": "tsx scripts/office-dev.ts --media --lan",
    "office:media:lan:https": "tsx scripts/office-dev.ts --media --lan --https",
    "office:bootstrap": "tsx scripts/office-bootstrap.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/database.ts migrate",
    "db:seed": "tsx scripts/database.ts seed",
    "db:import-fixtures": "tsx scripts/database.ts import-fixtures",
    "dev": "next dev -p 3400",
    "build": "next build",
    "start": "next start -p 3400",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@livekit/components-react": "^2.9.24",
    "@livekit/components-styles": "^1.2.0",
    "@next/env": "^16.3.4",
    "@sentry/nextjs": "~11.6.0",
    "drizzle-orm": "^0.45.2",
    "livekit-client": "^2.22.2",
    "livekit-server-sdk": "^2.18.0",
    "next": "16.3.8",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "vitest": "^4.1.12"
  }
}
